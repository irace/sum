{
  "name": "sum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w @sum/api\" \"npm run dev -w @sum/web\"",
    "build": "npm run build -w @sum/contracts && npm run build -w @sum/db && npm run build -w @sum/web && npm run build -w @sum/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @sum/db",
    "db:migrate": "npm run db:migrate -w @sum/db",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "vite": "7.3.6"
  }
}
